# PostgreSQL connection. Local dev: `npm run db:start` serves PGlite on 5442.
# Production: a Neon/Supabase pooled URL with ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5442/postgres?connection_limit=1&pgbouncer=true&sslmode=disable"

# Session signing secret (>= 32 random chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Demo access accounts: comma-separated user:password:role (role = admin | analyst | viewer)
AUTH_USERS="admin:change-me:admin,viewer:change-me-too:viewer"

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# Max upload size in MB for workbook imports
MAX_UPLOAD_MB="25"
