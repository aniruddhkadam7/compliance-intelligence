// Compliance Intelligence Platform — data model.
//
// Two independent layers:
//   GLOBAL  Framework, Citation (obligation / source section), SourceRelationship, connector & update tables.
//           Loaded through the library import; upserted, never deleted by client imports or client resets.
//   CLIENT  Client, CcfControl, TestProcedure, ControlObligation, MappingProposal, evidence.
//           Loaded through the client control import; scoped to a client; reset independently.
// Shaped by inspection of "CCF Demonstration.xlsx" (see docs/DATA_DICTIONARY.md).
// Every workbook-derived row keeps `raw` (original headers -> original cell values)
// and `sourceSheet`/`sourceRow` for traceability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Reference data (from workbook)
// ---------------------------------------------------------------------------

/// One row of "ArC Parent Sources (Metadata)". ArC calls these "authoritative sources".
model Framework {
  id               String   @id @default(cuid())
  sourceId         String   @unique /// "Source ID"
  name             String /// "Source Name"
  description      String? /// "Description"
  group            String? /// "Group"
  type             String? /// "Type"
  jurisdiction     String? /// "Jurisdiction"
  licensing        String? /// "Licensing"
  documentUrl      String? /// "Document URL"
  prioritizedByGsk Boolean  @default(false) /// "Prioritized by GSK?"
  /// "IT/OT/AI Applicability" (optional supplied column), e.g. "IT, OT".
  applicability    String?
  /// Version label parsed from the source name (derived, may be null).
  versionLabel     String?
  /// Framework family parsed from the source name (derived, used to group versions).
  family           String?
  /// Version this one replaced, as stated by the publisher (recorded even when its text is not loaded).
  /// Null with a note means the publisher lists no earlier version.
  previousVersion        String?
  /// Publisher facts behind previousVersion (dates, edition, what replaced what).
  previousVersionNote    String?
  /// Official page or catalogue the previous-version facts were taken from.
  previousVersionSource  String?
  raw              Json
  sourceSheet      String
  sourceRow        Int
  importJobId      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  citations  Citation[]
  connectors Connector[]
  updateChecks UpdateCheck[]

  @@index([family])
}

/// One row of "ArC Citations to Sources (Meta)": a section of an authoritative source.
model Citation {
  id              String   @id @default(cuid())
  sourceSectionId String   @unique /// "Source Section ID"
  frameworkId     String
  authSource      String /// "Auth. Source" as written in the citation sheet
  sectionName     String /// "Source Section Name"
  /// Unlabelled 6th column of the citation sheet: full section text.
  sectionText     String?
  raw             Json
  sourceSheet     String
  sourceRow       Int
  importJobId     String?
  createdAt       DateTime @default(now())

  framework    Framework                 @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  requirements RequirementCitation[]
  controls     ControlObligation[]
  procedures   TestProcedureObligation[]
  relationsFrom SourceRelationship[] @relation("relFrom")
  relationsTo   SourceRelationship[] @relation("relTo")
  proposals     MappingProposal[]

  @@index([frameworkId])
  @@index([sectionName])
}

/// One row of "ArC Full IR Ref (Metadata)" — an ArC Integrated Requirement (IR).
model IntegratedRequirement {
  id                      String   @id @default(cuid())
  requirementId           String   @unique /// "Requirement ID"
  riskTopic               String? /// "Risk Topic"
  name                    String? /// "Requirement Name"
  riskStatement           String? /// "Risk statement"
  foundInPrioritized      Boolean? /// "Found in Prioritized Sources?"
  /// "Count in CCF v2 Mapping?" exactly as stated by the workbook.
  statedCcfMappingCount   Int?
  controlObjective        String? /// "Control objective"
  class                   String? /// "Class"
  raw                     Json
  sourceSheet             String
  sourceRow               Int
  importJobId             String?
  createdAt               DateTime @default(now())

  citations  RequirementCitation[]
  mappings   ControlRequirementMapping[]
  reviews    UnmappedRequirementReview[]

  @@index([riskTopic])
}

/// Citation -> Integrated Requirement link ("Requirement ID" column of the citation sheet).
model RequirementCitation {
  id            String @id @default(cuid())
  citationId    String
  requirementId String

  citation    Citation              @relation(fields: [citationId], references: [id], onDelete: Cascade)
  requirement IntegratedRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([citationId, requirementId])
  @@index([requirementId])
}

/// One row of "CCFv2 (Metadata)" (authoritative), enriched with crosswalk
/// columns from the "Metadata(CCFv2)" working sheet.
model CcfControl {
  id                        String   @id @default(cuid())
  controlName               String   @unique /// "New Common Control Name " (e.g. AI-CCF-1)
  /// Owning client (client data layer).
  clientId                  String?
  domainPrefix              String /// derived: name without trailing number (e.g. AI-CCF)
  scope                     String? /// "Scope (GRC/CSO/OT/DCJ)"
  coverageInIsms            String? /// "Coverage in ISMS Standards"
  category                  String? /// "Control Categories"
  subCategory               String? /// "Control Sub Category"
  title                     String? /// "Common Control Title"
  objective                 String? /// "Control Objective"
  activityStatementV1       String? /// "Control Activity Statement (CCFv1.0)"
  activityStatementV2       String? /// "Control Activity Statement (CCFv2.0)"
  monitoringStatements      String? /// "Monitoring Statements"
  technicalType             String? /// "Technical/Non-technical Control"
  standardsControlMapping   String? /// "Standards Control Mapping\n(CCFv2.0)"
  productImplementation     String? /// "Product Implementation Guidance"
  mappedIsmsSubControls     String? /// "Mapped ISMS Standard Sub-Controls"
  productTeamFacing         String? /// "Product Team Facing? (CCFv2.0)"
  orgLevel                  String? /// "Org. Level/Product Level\n(Proposed) v2.0"
  arcActivityStatement      String? /// "ArC Activity Statement"
  monitoringCriteria        String? /// "Monitoring criteria"
  toolsDocuments            String? /// "Tools/Documents (CCF V2)"
  relatedGskStandard        String? /// "Related GSK Standard"
  gskAssignee               String? /// "GSK Assignee"
  gskComments               String? /// "GSK Comments"
  teamComments              String? /// "Team Comments"
  notes                     String? /// "Notes / Comments / Feedback"
  arcRiskStatement          String? /// "ArC Mapping\nRisk Statement"
  arcRiskObjective          String? /// "ArC Mapping\nRisk Objective"
  /// Review fields only present on the working sheet.
  gskReviewStatus           String? /// "GSK Ready for Review?" (Metadata(CCFv2))
  gskApproval               String? /// "GSK Approved OR  To Discuss" (Metadata(CCFv2))
  /// In the client's scope: counted in coverage, gaps and update flags. All controls start in scope; the client
  /// can narrow it, and a re-import keeps each control's choice.
  inScope                   Boolean  @default(true)
  /// Listed on the workbook's client selection sheet ("CCFv2") when the full catalogue is imported.
  inClientSelection         Boolean  @default(false)
  raw                       Json /// authoritative sheet row
  workingRaw                Json? /// matching "Metadata(CCFv2)" row
  sourceSheet               String
  sourceRow                 Int
  importJobId               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  client              Client?                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mappings            ControlRequirementMapping[]
  obligations         ControlObligation[]
  proposals           MappingProposal[]
  testProcedures      TestProcedure[]
  evidence            EvidenceRequirement[]
  frameworkReferences ControlFrameworkReference[]

  @@index([domainPrefix])
  @@index([category])
}

enum MappingType {
  PRIMARY /// "ARC Mapping"
  SECONDARY /// "Secondary ArC Mapping"
}

/// CCF control -> Integrated Requirement, as stated in a specific sheet.
/// Values that are not a resolvable Requirement ID are kept with requirementId = null.
model ControlRequirementMapping {
  id            String      @id @default(cuid())
  controlId     String
  requirementId String?
  mappingType   MappingType
  rawValue      String
  /// True when the row comes from the authoritative "CCFv2 (Metadata)" sheet.
  authoritative Boolean
  sourceSheet   String
  sourceColumn  String
  createdAt     DateTime    @default(now())

  control     CcfControl             @relation(fields: [controlId], references: [id], onDelete: Cascade)
  requirement IntegratedRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([controlId])
  @@index([requirementId])
  @@index([authoritative, mappingType])
}

model TestProcedure {
  id           String  @id @default(cuid())
  controlId    String
  kind         String /// e.g. PROCEDURE, CCF_V2, CCF_V1, ARC_WITHOUT_CITATIONS, ARC_WITH_CITATIONS
  /// Test procedure identifier from the mapping sheet, e.g. "AM-CCF-1:TP2".
  procedureId  String?
  text         String
  sourceSheet  String
  sourceColumn String

  control     CcfControl                @relation(fields: [controlId], references: [id], onDelete: Cascade)
  obligations TestProcedureObligation[]

  @@index([controlId])
}

/// Test procedure -> obligation (source section) it tests, from the mapping sheet.
model TestProcedureObligation {
  id              String @id @default(cuid())
  testProcedureId String
  citationId      String

  testProcedure TestProcedure @relation(fields: [testProcedureId], references: [id], onDelete: Cascade)
  citation      Citation      @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@unique([testProcedureId, citationId])
  @@index([citationId])
}

/// CCF control -> regulatory obligation. The single mapping every screen reads.
/// Filled from test procedure mappings (source-ID workbooks) or, for legacy
/// workbooks, resolved at import time from their mapping columns.
model ControlObligation {
  id          String @id @default(cuid())
  controlId   String
  citationId  String
  /// PROCEDURE (via a test procedure), PRIMARY or SECONDARY (legacy mapping columns)
  mappingType String

  control  CcfControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  citation Citation   @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@unique([controlId, citationId])
  @@index([citationId])
}

model EvidenceRequirement {
  id           String @id @default(cuid())
  controlId    String
  kind         String /// GO_LIVE, CCF_V1, CCF_V1_UPDATED
  text         String
  sourceSheet  String
  sourceColumn String

  control CcfControl @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@index([controlId])
}

/// Direct standards references stated per control on the working sheet
/// (columns such as "NIST CSF 1.1", "NIST CSF 2.0", "GDPR"...).
model ControlFrameworkReference {
  id           String   @id @default(cuid())
  controlId    String
  columnName   String /// original column header
  referenceRaw String
  tokens       String[] /// comma-split references, trimmed
  sourceSheet  String

  control CcfControl @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@index([controlId])
  @@index([columnName])
}

/// Rows of the "Unmapped IRs (...)" analysis sheets. These are review analyses,
/// NOT approved mappings.
model UnmappedRequirementReview {
  id            String  @id @default(cuid())
  requirementId String
  sheetName     String
  raw           Json
  sourceRow     Int
  importJobId   String?

  requirement IntegratedRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, sheetName])
  @@index([sheetName])
}

// ---------------------------------------------------------------------------
// Ingestion
// ---------------------------------------------------------------------------

enum ImportStatus {
  PREVIEWED
  COMPLETED
  FAILED
}

model ImportJob {
  id          String       @id @default(cuid())
  kind        String /// LIBRARY | CLIENT_CONTROLS | RELATIONSHIPS (legacy: CCF_WORKBOOK, TRANSITION_WORKBOOK)
  clientId    String?
  /// Client mapping that this import replaced, kept so the previous approved mapping stays traceable.
  previousMapping Json?
  fileName    String
  fileSize    Int
  fileHash    String
  status      ImportStatus
  sheets      Json /// per-sheet summary (headers, row counts, role)
  counts      Json? /// records written per entity
  actor       String
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  issues ImportIssue[]
}

model ImportIssue {
  id          String  @id @default(cuid())
  importJobId String
  severity    String /// ERROR | WARNING | INFO
  code        String
  sheet       String?
  row         Int?
  column      String?
  message     String

  job ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
}

// ---------------------------------------------------------------------------
// Version impact (transition workbook supplied by the team)
// ---------------------------------------------------------------------------

model VersionTransition {
  id                   String   @id @default(cuid())
  importJobId          String
  /// When true the row came from a clearly labelled sample file, not GSK data.
  isSample             Boolean  @default(false)
  controlName          String?
  oldFrameworkVersion  String?
  newFrameworkVersion  String?
  oldSectionId         String?
  newSectionId         String?
  previousFunction     String?
  newFunction          String?
  previousCitation     String?
  updatedCitation      String?
  existingTestProcedure String?
  updatedTestProcedure String?
  existingEvidence     String?
  additionalEvidence   String?
  scenario             String? /// as stated in the workbook, if present
  raw                  Json
  sourceSheet          String
  sourceRow            Int
  createdAt            DateTime @default(now())

  @@index([importJobId])
}

// ---------------------------------------------------------------------------
// External update monitoring (independent of the mapping workflow)
// ---------------------------------------------------------------------------

model Connector {
  id                String    @id /// stable slug, e.g. nist-csf2-cprt
  name              String
  sourceName        String
  publisher         String
  mechanism         String /// JSON_DOWNLOAD | SPARQL | HTTP_FINGERPRINT | ...
  officialUrl       String
  endpointUrl       String
  frameworkId       String?
  pollingMinutes    Int
  enabled           Boolean   @default(true)
  currentVersion    String?
  currentHash       String?
  lastCheckedAt     DateTime?
  lastSuccessAt     DateTime?
  lastStatus        String? /// OK | CHANGED | ERROR
  lastError         String?
  state             Json? /// connector-specific baseline (etag, item ids, ...)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  framework Framework?       @relation(fields: [frameworkId], references: [id], onDelete: SetNull)
  checks    ConnectorCheck[]
  updates   FrameworkUpdate[]
}

model ConnectorCheck {
  id            String   @id @default(cuid())
  connectorId   String
  trigger       String /// MANUAL | SCHEDULED
  status        String /// OK | CHANGED | BASELINE | ERROR
  httpStatus    Int?
  durationMs    Int?
  contentHash   String?
  detectedVersion String?
  message       String?
  details       Json?
  actor         String?
  checkedAt     DateTime @default(now())

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId, checkedAt])
}

model FrameworkUpdate {
  id           String    @id @default(cuid())
  connectorId  String
  changeType   String /// VERSION_CHANGE | CONTENT_CHANGE | NEW_PUBLICATION | NEW_INFORMATIVE_REFERENCE
  title        String
  summary      String
  details      Json?
  previousValue String?
  newValue     String?
  reviewStatus String    @default("NEW") /// NEW | ACKNOWLEDGED | DISMISSED
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNote   String?
  detectedAt   DateTime  @default(now())

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([reviewStatus])
  @@index([detectedAt])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  role      String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Global: relationships between source sections (supplied files only)
// ---------------------------------------------------------------------------

/// VERSION_TRANSITION: legacy section -> latest section (from/to may be empty for added/removed).
/// CROSS_FRAMEWORK: section in one document related to a section in another.
model SourceRelationship {
  id             String   @id @default(cuid())
  kind           String
  fromSourceId   String?
  toSourceId     String?
  fromCitationId String?
  toCitationId   String?
  /// UNCHANGED | MODIFIED | ADDED | REMOVED | SPLIT | COMBINED (transitions) or the stated relationship type
  status         String
  note           String?
  raw            Json
  sourceSheet    String
  sourceRow      Int
  importJobId    String?
  createdAt      DateTime @default(now())

  fromCitation Citation? @relation("relFrom", fields: [fromCitationId], references: [id], onDelete: SetNull)
  toCitation   Citation? @relation("relTo", fields: [toCitationId], references: [id], onDelete: SetNull)
  proposals    MappingProposal[]

  @@index([kind, status])
  @@index([fromCitationId])
  @@index([toCitationId])
}

// ---------------------------------------------------------------------------
// Client layer
// ---------------------------------------------------------------------------

model Client {
  id        String       @id @default(cuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  controls  CcfControl[]
  proposals MappingProposal[]
}

/// A proposed change to a client's approved control-to-obligation mapping (e.g. from Version Impact).
/// Applied only after human approval.
model MappingProposal {
  id             String    @id @default(cuid())
  clientId       String
  controlId      String
  /// ADD (map the control to citationId) or REMOVE (unmap it)
  action         String
  citationId     String
  relationshipId String?
  /// Version update (AiIngestion) that produced this proposal, with the change behind it and its confidence.
  ingestionId    String?
  changeType     String?
  confidence     Float?
  reason         String
  status         String    @default("PENDING") /// PENDING | APPROVED | REJECTED
  createdBy      String
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())

  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  control      CcfControl          @relation(fields: [controlId], references: [id], onDelete: Cascade)
  citation     Citation            @relation(fields: [citationId], references: [id], onDelete: Cascade)
  relationship SourceRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([ingestionId])
}

/// GLOBAL. AI-assisted document import: an uploaded framework document read by an AI model into a draft.
/// Nothing reaches the library until a reviewer publishes the draft.
model AiIngestion {
  id                   String   @id @default(cuid())
  fileName             String
  fileHash             String
  status               String   @default("EXTRACTING") /// EXTRACTING | READY | PUBLISHED | DISCARDED | FAILED
  model                String
  /// Plain text extracted from the file; pages separated by form feeds. Used to verify every section.
  text                 String
  pages                Int
  chunks               Int
  chunksDone           Int      @default(0)
  /// AI identification: title, shortTitle, publisher, version, publishedDate, documentType, jurisdiction.
  detected             Json?
  /// Library document of the same family the draft was matched to (deterministic), and how.
  matchFrameworkId     String?
  matchKind            String? /// SAME_VERSION | NEW_VERSION | NEW_DOCUMENT
  /// AI-generated change summary against the matched document (labelled as AI output).
  summary              String?
  usage                Json?
  error                String?
  publishedFrameworkId String?
  /// Version comparison (relations between old and new sections) and the reviewer decision.
  analysis             Json?
  reviewNote           String?
  reviewedAt           DateTime?
  createdBy            String
  reviewedBy           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  sections AiDraftSection[]

  @@index([status])
}

model AiDraftSection {
  id          String  @id @default(cuid())
  ingestionId String
  ordinal     Int
  identifier  String
  title       String
  /// Heading path above the section, e.g. ["Protect (PR)", "Data Security (PR.DS)"].
  path        Json
  /// Text cut from the document between the AI-located anchors (never generated by the model).
  text        String
  /// Both anchors were found verbatim in the extracted document text.
  verified    Boolean
  include     Boolean @default(true)
  /// REQUIREMENT | RECOMMENDATION | GUIDANCE | DEFINITION | EXAMPLE | REFERENCE | SECTION (AI classification; original text unchanged)
  contentType      String?
  /// Publisher identifier of the parent section, as printed (never generated).
  parentIdentifier String?
  /// Source location: PDF page, or worksheet and row.
  pageNumber       Int?
  sheetName        String?
  rowNumber        Int?
  /// 1 when the text was copied verbatim from the source; lower for OCR or partial matches.
  confidence       Float?

  ingestion AiIngestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)

  @@index([ingestionId])
}

/// GLOBAL. Result of a "Check for Updates" against the publisher's official source. Evidence is stored with
/// every result; a failed or unverifiable check is recorded as such and never as "up to date".
model UpdateCheck {
  id                String   @id @default(cuid())
  frameworkId       String
  /// PUBLISHER_DATA (structured official source) | OFFICIAL_PAGE (official page read with verified quotes) | NONE
  method            String
  sourceUrl         String?
  /// UP_TO_DATE | UPDATE_AVAILABLE | UNABLE_TO_VERIFY | CHECK_FAILED
  status            String
  approvedVersion   String?
  latestVersion     String?
  publicationDate   String?
  latestDocumentUrl String?
  /// Quotes, publisher fields, HTTP status and fingerprints that support the result.
  evidence          Json?
  message           String?
  checkedBy         String?
  checkedAt         DateTime @default(now())

  framework Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@index([frameworkId, checkedAt])
}
